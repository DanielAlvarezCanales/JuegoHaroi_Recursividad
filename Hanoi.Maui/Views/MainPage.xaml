<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hanoi.Maui.Views.MainPage"
             Title="Juego de Hanoi">

    <ScrollView>
        <VerticalStackLayout 
            Padding="30" 
            Spacing="25" 
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            MaximumWidthRequest="600">
            
            <Label 
                Text="Torres de Hanói"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Label 
                Text="Resolución automática mediante algoritmo recursivo"
                FontSize="16"
                HorizontalOptions="Center"
                TextColor="Gray"
                Margin="0,0,0,10"/>

            <!-- El Lienzo de Dibujo NATIVO -->
            <Border 
                StrokeThickness="2"
                StrokeShape="RoundRectangle 10"
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">

                <GraphicsView 
                    x:Name="MiGrafico"
                    HeightRequest="300"
                    WidthRequest="450"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Panel de Controles e Información -->
            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">

                <!-- Botón Principal para disparar la Recursividad -->
                <Button 
                    x:Name="BtnResolver"
                    Text="Iniciar Resolución" 
                    Clicked="OnResolverAutomaticoClicked" 
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="50"
                    WidthRequest="250"
                    HorizontalOptions="Center"
                    CornerRadius="25"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"/>


            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
